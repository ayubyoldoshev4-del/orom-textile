[Unit]
Description=OROM TEXTILE 24/7 Telegram Bot Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/orom_textile_bot
ExecStart=/var/www/orom_textile_bot/venv/bin/python main.py
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=10
EnvironmentFile=/var/www/orom_textile_bot/.env

[Install]
WantedBy=multi-user.target
